<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Profile</title>
    <!-- add icon link -->
    <link rel="icon" href="image/Logo_CalorieCare.png" type="image/x-icon" />
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="css/styles.css" rel="stylesheet" />
    <style>
        li {
            display: block;
            list-style-type: disc;
            margin-top: 0;
            margin-bottom: 0;
            margin-left: 0;
            margin-right: 0;
            padding-left: 100px;
            } 
        @media (max-width: 767.98px) {
            li {
                display: block;
                list-style-type: disc;
                text-align: end;
                margin-top: 0;
                margin-bottom: 0;
                margin-left: 0;
                margin-right: 0;
                padding-left: 0;
            } 
            .grid {
                grid-template-columns: 1fr; /* ให้เป็น 1 คอลัมน์สำหรับขนาดเล็ก */
            }
            h1 {
                text-align: end; /* จัดข้อความใน h1 ไปทางขวา */
                font-size: 40px;
            }
            }
    </style>
</head>
<body>
        <!-- Navigation-->
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container px-4 px-lg-5">
                <a class="navbar-brand" href="/home">
                    <img src="image/logo.png" alt="Bootstrap" width="48" height="48">
                  </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item"><a class="nav-link" href="/home">หน้าหลัก</a></li>
                        <li class="nav-item"><a class="nav-link" href="/excercise">ออกกำลังกาย</a></li>
                        <li class="nav-item"><a class="nav-link" href="/history">ประวัติ</a></li>
                        <li class="nav-item"><a class="nav-link" href="/target">เป้าหมาย</a></li>
                        <li class="nav-item"><a class="nav-link" href="/calculator">คำนวณ</a></li>
                    </ul>
                    <form class="d-flex">
                        <% if (loggedIn) { %>
                            <h1><a class="nav-link" href="/profile"><i class="bi bi-person-circle text-green"></i></a></h1>
                        <% } %>
        
                        <% if (!loggedIn) { %>
                            <a class="btn btn-outline-green mx-3" href="/login">เข้าสู่ระบบ</a>
                            <a class="btn btn-outline-green" href="/register">สมัครสมาชิก</a>
                        <% } %>
                    </form>
                </div>
            </div>
        </nav>

        <!-- Header-->
        <header class="py-3">
            <div class="container px-4 px-lg-5 my-1">
                <div class="text-center text-green">
                    <h4 class="display-6 fw-bolder">บัญชีผู้ใช้</h4>
                </div>

            </div>
        </header>

        <div>
            <div class="container" style="width: auto;">
                <div class="card mb-3">
                    <div class="card-body ms-2">
                        <p class="card-text">
                          <div class="container">
                            <div class="row">
                                <div class="col-md-auto col-3 m-0">
                                    <i class="bi bi-person-circle text-green display-1"></i>
                                </div>
                                <div class="col-sm-auto col-9 m-0">
                                    <h6 class="fw-bolder text-green" id="username">Username</h6>
                                    <%= UserData.username %>
                                    <h6 class="fw-bolder text-green">Email</h6>
                                    <%= UserData.email %>
                                </div>
                            </div>
                          </div>
                          <hr>
                          <h4 class="card-title fw-bolder text-green mt-4">ข้อมูลส่วนตัว</h4>
                          <p class="m-0" style="text-align:left;">
                            เพศ
                            <span class="text-gray" style="float:right;">
                                <% if (UserData.gender === 'male') { %>
                                    ชาย <i class="bi bi-gender-male text-primary"></i>
                                <% } else if (UserData.gender === 'female') { %>
                                    หญิง <i class="bi bi-gender-female text-pink"></i>
                                <% } else { %>
                                    ไม่ระบุ
                                <% } %>                                
                            </span>
                          </p>
                          <p class="m-0" style="text-align:left;">
                            อายุ
                            <span class="text-gray" style="float:right;"><%= UserData.age %> ปี
                            </span>
                          </p>
                          <p class="m-0" style="text-align:left;">
                            น้ำหนักปัจจุบัน
                            <span class="text-gray" style="float:right;"><%= UserData.weight %> kg.
                            </span>
                          </p>

                          <p class="m-0" style="text-align:left;">
                            ส่วนสูง
                            <span class="text-gray fw" style="float:right;"><%= UserData.height %> cm.
                            </span>
                          </p>
                        </p>
                        <div class="grid">
                            <div class="grid-item text-end"> <!-- ใช้ text-end เพื่อจัดตำแหน่งขวา -->
                                    <button type="submit" class="btn btn-outline-green" style="width: auto; min-width: 100px;" data-bs-toggle="modal" data-bs-target="#editprofile"> <!-- เปลี่ยน width เป็น auto และกำหนด min-width -->
                                        <i class="bi bi-pencil-square"></i> แก้ไขข้อมูลส่วนตัว
                                    </button>
                            </div>
                        </div>                                          
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body ms-2">
                      <h4 class="card-title fw-bolder text-green ">เป้าหมายสุขภาพ</h4>
                      <p class="card-text" >
                        <p class="m-0" style="text-align:left;">
                            ประเภทเป้าหมาย
                            <span class="text-gray" style="float:right;" id="display-target">
                                <% if (UserData.target === null) { %>
                                    ยังไม่ได้ตั้งเป้าหมาย
                                <% } else { %>
                                    <% if (UserData.target === 'LoseWeight') { %>
                                        ลดน้ำหนัก
                                    <% } else if (UserData.target === 'GainWeight') { %>
                                        เพิ่มน้ำหนัก
                                    <% } else if (UserData.target === 'MaintainWeight') { %>
                                        รักษาน้ำหนัก
                                    <% } else { %>
                                        <%= UserData.target %> <!-- สำหรับค่าที่อาจจะไม่ได้คาดการณ์ -->
                                    <% } %>
                                <% } %>
                            </span>
                        </p>

                        <p class="m-0" style="text-align:left;">
                            น้ำหนักเป้าหมาย
                            <span class="text-gray" style="float:right;">
                                <% if (UserData.weight_target === null) { %>
                                    ยังไม่ได้ตั้งเป้าหมาย
                                <% } else { %>
                                    <%= UserData.weight_target %> kg.
                                <% } %>
                            </span>
                        </p>
                        
                        <p class="m-0" style="text-align:left;">
                            เป้าหมายแคลอรี่ต่อวัน
                            <span class="text-gray" style="float:right;" id="display-tdee">
                                <%= UserData.tdee %> kcal.
                            </span>
                        </p>
                        <p class="m-0" style="text-align:left;">
                            เผาผลาญแคลอรี่ต่อวัน
                            <span class="text-gray" style="float:right;" id="display-bmr">
                                <%= UserData.bmr %> kcal.
                            </span>
                        </p>
                        <p class="m-0" style="text-align:left;">
                            กิจกรรมการออกกำลังกาย
                            <span class="text-gray" style="float:right;">
                                <% if (UserData.activity === 'Sedentary') { %>
                                    ออกกำลังกายน้อย
                                <% } else if (UserData.activity === 'Light') { %>
                                    ออกกำลังกายเบาๆ
                                <% } else if (UserData.activity === 'Moderate') { %>
                                    ออกกำลังกายปานกลาง
                                <% } else if (UserData.activity === 'Active') { %>
                                    ออกกำลังกายหนักมาก
                                <% } else if (UserData.activity === 'VeryActive') { %>
                                    ฝึกซ้อมหนักทุกวันไม่หยุด
                                <% } else { %>
                                    ไม่ระบุประเภทกิจกรรม
                                <% } %>
                            </span>
                        </p>
                        
                      </p>
                      <p style="text-align:right;">
                        <a href="/logout" class="btn btn-outline-danger" style="width: auto; min-width: 100px;">
                            <i class="bi bi-box-arrow-right"></i> ออกจากระบบ
                        </a>
                    </p> 
                    </div>
                </div>              
            </div>
        </div>

  <!-- Modal -->
    <div class="modal fade" id="signout" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <div class="text-center">
                <img src="image/Logo 1.png" alt="Bootstrap" width="250" height="250">
                <p class="m-0">
                    <h4 class="text-green">ออกจากระบบ</h4>
                    <h6>คุณต้องการออกจากระบบหรือไม่ ?</h6>
                </p>
                <button type="button" class="btn btn-outline-green w-25" data-bs-dismiss="modal">ไม่</button>
                <button class="btn btn-outline-green w-25"><a href="/logout" class="link-green" style="text-decoration: none;">ใช่</a></button>
            </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="signoutsuccess" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="text-center">
            <img src="image/Logo 1.png" alt="Bootstrap" width="250" height="250">
            <p class="m-0">
                <h4 class="text-green">ออกจากระบบ</h4>
                <h6>คุณทำการออกจากระบบสำเร็จ</h6>
                <img class="mt-3" src="image/checked.png" alt="Bootstrap" width="100" height="100"><br>
                <button class="btn btn-outline-green mt-3"><a href="index.html" class="link-green" style="text-decoration: none;">กลับเข้าสู่หน้าหลัก</a></button>
            </p>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="editprofile" data-bs-backdrop="static" data-bs-keyboard="true" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-green">
                <h1 class="modal-title fs-5 text-white" id="staticBackdropLabel">แก้ไขข้อมูลส่วนตัว</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center">
                    <h1><i class="bi bi-person-circle display-1 text-green"></i></h1>
                </div>
                <form action="/user/edit" method="POST">
                    <div class="container"> 
                        <div class="row">
                            <div class="text-green">
                                <h4 class="text-green mt-4 fw-bolder">ข้อมูลส่วนตัว</h4>
                                <div class="text-green mt-3">
                                    <p>น้ำหนักตัว (kg.)</p>
                                    <input type="text" id="weight" name="weight" class="w-100" required/>
                                </div>
                                <div class="text-green mt-3">
                                    <p>ส่วนสูง (cm.)</p>
                                    <input type="text" id="height" name="height" class="w-100" required/>
                                </div>
                                <div class="text-green mt-3">
                                    <p>อายุ (ปี)</p>
                                    <input type="text" id="age" name="age" class="w-100" required/>
                                </div>
                                <p class="text-green mt-3">เพศ</p>
                                <div class="container mb-3"> 
                                    <div class="row">
                                        <div class="col text-center">
                                            <input type="radio" class="btn-check" name="gender" value="male" id="gender-bmr-male" autocomplete="off" required>
                                            <label class="btn btn-outline-primary w-100" for="gender-bmr-male"><i class="bi bi-gender-male"></i> ผู้ชาย</label>
                                        </div>
                                        <div class="col text-center">
                                            <input type="radio" class="btn-check" name="gender" value="female" id="gender-bmr-female" autocomplete="off" required>
                                            <label class="btn btn-pink w-100" for="gender-bmr-female"><i class="bi bi-gender-female"></i> ผู้หญิง</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="submit" class="btn btn-outline-green">บันทึกข้อมูล</button>
                </form>
            </div>
        </div>
    </div>
</div>


  <div class="modal fade" id="editsuccess" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="text-center">
            <img src="image/Logo 1.png" alt="Bootstrap" width="250" height="250">
            <p class="m-0">
                <h4 class="text-green">แก้ไขข้อมูลผู้ใช้สำเร็จ</h4>
                <h6>คุณทำการแก้ไขข้อมูลสำเร็จ</h6>
                <img class="mt-3" src="image/checked.png" alt="Bootstrap" width="100" height="100"><br>
                <button class="btn btn-outline-green mt-3"><a href="profile.html" class="link-green" style="text-decoration: none;">กลับเข้าสู่บัญชี</a></button>
            </p>
        </div>
      </div>
    </div>
  </div>


  


            <!-- Bootstrap core JS-->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
            <!-- Core theme JS-->
            <script src="js/scripts.js"></script>
            <script src="js/profile.js"></script>
</body>
</html>