<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Calculator for fitness tracking" />
    <meta name="author" content="Your Name" />
    <title>History</title>
    <link rel="icon" href="image/Logo_CalorieCare.png" type="image/x-icon" />
    <link rel="stylesheet" href="css/styles.css" />
    <link rel="stylesheet" href="css/history.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        li {
          display: block;
          list-style-type: disc;
          margin-top: 0;
          margin-bottom: 0;
          margin-left: 0;
          margin-right: 0;
          padding-left: 100px;
          } 
        @media (max-width: 767.98px) {
              li {
                  display: block;
                  list-style-type: disc;
                  text-align: end;
                  margin-top: 0;
                  margin-bottom: 0;
                  margin-left: 0;
                  margin-right: 0;
                  padding-left: 0;
              } 
              .grid {
                  grid-template-columns: 1fr; /* ให้เป็น 1 คอลัมน์สำหรับขนาดเล็ก */
              }
              h1 {
                  text-align: end; /* จัดข้อความใน h1 ไปทางขวา */
                  font-size: 40px;
              }
              }
      </style>
</head>
<body>
        <!-- Navigation-->
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container px-4 px-lg-5">
                <a class="navbar-brand" href="/home">
                    <img src="image/logo.png" alt="Bootstrap" width="48" height="48">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 d-flex justify-content-between">
                        <li class="nav-item"><a class="nav-link" href="/home">หน้าหลัก</a></li>
                        <li class="nav-item"><a class="nav-link" href="/excercise">ออกกำลังกาย</a></li>
                        <li class="nav-item"><a class="nav-link active" aria-current="page" href="/history">ประวัติ</a></li>
                        <li class="nav-item"><a class="nav-link" href="/target">เป้าหมาย</a></li>
                        <li class="nav-item"><a class="nav-link" href="/calculator">คำนวณ</a></li>
                    </ul>
        
                    <form>
                        <% if (loggedIn) { %>
                            <h1 class="m-0"><a class="nav-link" href="/profile"><i class="bi bi-person-circle text-green"></i></a></h1>
                        <% } %>
        
                        <% if (!loggedIn) { %>
                            <a class="btn btn-outline-green mx-3" href="/login">เข้าสู่ระบบ</a>
                            <a class="btn btn-outline-green" href="/register">สมัครสมาชิก</a>
                        <% } %>
                    </form>
                </div>
            </div>
        </nav>

        <!-- calendars -->
        <div class="calendars">
            <div class="left">
                <div class="calendar">
                  <div class="month">
                    <i class="fas fa-angle-left prev"  style="font-size: 24px;"></i>
                    <div class="date"></div>
                    <i class="fas fa-angle-right next"  style="font-size: 24px;"></i>
                  </div>
                  <div class="weekdays">
                    <div>อาทิตย์</div>
                    <div>จันทร์</div>
                    <div>อังคาร</div>
                    <div>พุธ</div>
                    <div>พฤหัสบดี</div>
                    <div>ศุกร์</div>
                    <div>เสาร์</div>
                  </div>
                  <div class="days"></div>
                  <div class="goto-today">
                    <div class="goto">
                      <input type="text" placeholder="mm/yyyy" class="date-input" />
                      <button class="goto-btn">Go</button>
                    </div>
                    <button class="today-btn">Today</button>
                  </div>
                </div>
              </div>
    <!--event-->
    <div class="right">
        <div class="today-date" style="font-size: 24px;">
          <div class="event-day" style="color: #839788;"></div>
          <div class="event-date"  style=" color: #839788;"></div>
        </div>
<div class="container mt-5">
                <h2 class="text-center">ประวัติการรับประทานอาหาร</h2>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>วันที่</th>
                                <th>ชื่ออาหาร</th>
                                <th>จำนวน</th>
                                <th>แคลอรี่</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (foodLogs.length > 0) { %>
                                <% let totalCaloriesForDay = 0; %>
                                <% const currentDate = new Date().toLocaleDateString('th-TH'); %>
                                <% foodLogs.forEach(log => { %>
                                    <% const logDate = new Date(log.date).toLocaleDateString('th-TH'); %>
                                    <% if (logDate === currentDate) { %>
                                        <% totalCaloriesForDay += log.calories * log.quantity; %>
                                    <% } %>
                                    <tr>
                                        <td><%= logDate %></td>
                                        <td><%= log.name %></td>
                                        <td><%= log.quantity %></td>
                                        <td><%= log.calories %> kcal</td>
                                    </tr>
                                <% }); %>
                                <tr>
                                    <td colspan="4" class="text-end"><strong>รวมแคลอรี่ทั้งหมดในวันนี้: <%= totalCaloriesForDay %> kcal</strong></td>
                                </tr>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center">ไม่มีข้อมูลประวัติ</td>
                                </tr>
                            <% } %>
                        </tbody>              
                    </table>
                </div>
            </div>
        </div>
</div>
</div>
      
    
        
        <div class="events"></div>
        <div class="add-event-wrapper">
          <div class="add-event-header">
            <div class="title">Add Event</div>
            <i class="fas fa-times close"></i>
          </div>
          <div class="add-event-body">
            <div class="add-event-input">
              <input type="text" placeholder="Menu" class="event-name" />
            </div>
            <div class="add-event-input">
              <input
                type="number"
                placeholder="Calorie"
                class="event-kcal"
              />
            </div>
            <div class="add-event-input">
              <input
                type="text"
                placeholder="Quantity"
                class="event-quantity"
              />
            </div>
          </div>
          <div class="add-event-footer">
    
            <button class="add-event-btn">Add Event</button>
          </div>
        </div>
      </div>
        <div>
            <!--button class="add-event">
                <i class="bi bi-plus-lg"  ></i>
              </button-->
        </div>
        </div>


    <!-- Bootstrap core JS-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Core theme JS-->
    <script src="js/scripts.js"></script>
    <script src="js/history.js"></script>
</body>
</html>
