<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />
        <title>CalorieCare</title>
        <!-- add icon link -->
        <link rel="icon" href="image/Logo_CalorieCare.png" type="image/x-icon" />
        <!-- Favicon-->
        <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
        <!-- Bootstrap icons-->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
        <!-- Core theme CSS (includes Bootstrap)-->
        <link href="/css/styles.css" rel="stylesheet" />
        <!-- Font Awesome-->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
        <style>
            li {
                display: block;
                list-style-type: disc;
                margin-top: 0;
                margin-bottom: 0;
                margin-left: 0;
                margin-right: 0;
                padding-left: 100px;
            } 
            .grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); /* สำหรับหน้าจอขนาดปกติ */
            }

            @media (max-width: 767.98px) {
            li {
                display: block;
                list-style-type: disc;
                text-align: end;
                margin-top: 0;
                margin-bottom: 0;
                margin-left: 0;
                margin-right: 0;
                padding-left: 0;
            } 
            .grid {
                grid-template-columns: 1fr; /* ให้เป็น 1 คอลัมน์สำหรับขนาดเล็ก */
            }
            h1 {
                text-align: end; /* จัดข้อความใน h1 ไปทางขวา */
                font-size: 40px;
            }
            }

            .grid img {
                max-width: 100%; /* ทำให้รูปภาพไม่เกินขนาดของคอลัมน์ */
                height: auto;    /* รักษาสัดส่วนของรูปภาพ */
                max-height: 50px; /* กำหนดความสูงสูงสุดเพื่อป้องกันการใหญ่เกินไป */
                object-fit: contain; /* รักษาสัดส่วนรูปภาพ */
            }
            .fixed-image {
            max-width: 300px;
            max-height: 200px;
            width: auto;
            height: auto;
            object-fit: contain;
            }
        </style>
    </head>
