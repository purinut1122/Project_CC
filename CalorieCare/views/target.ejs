<!-- balance weight Modal-->
<div class="modal fade" id="balanceweight" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-green">
        <h5 class="modal-title text-white" id="staticBackdropLabel">ควบคุมน้ำหนัก</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="resetData();"></button>
      </div>
      <div class="modal-body">
        <div class="content">
          <div class="border border-secondary border-2 p-3 mb-2" style="border-radius: 5px;">
            <h5>น้ำหนักปัจจุบันของคุณ : <%= UserData.weight %> (kg.)</h5>
          </div>
          <!-- form -->
          <form id="Balanceform" action="/user/target" method="POST">
            <div class="form-control border border-secondary border-2 p-3 mb-2" style="border-radius: 5px;">
              <label for="inputWeight"><h5 class="fw-bolder">คุณอยากมีน้ำหนักเท่าไร (kg.)</h5></label><br>
              <input type="text" id="inputWeight" name="weight_target" onkeyup="clearInput(this);" placeholder="กรอกจำนวนตัวเลข" required>
              <p id="error-message" class="fw-bolder mt-2" style="color: #e74c3c;"></p>
            </div>
            <div class="border border-secondary border-2 p-3 mb-2" style="border-radius: 5px;">
              <h5 class="fw-bolder mb-2">คุณออกกำลังกายบ่อยแค่ไหน</h5>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="activity" value="Sedentary" id="exerciseNever" required>
                <label class="form-check-label" for="exerciseNever">
                  <h6>อยู่นิ่งๆ</h6>
                  <p class="text-green">ออกกำลังกายน้อยหรือไม่ออกกำลังกายเลย</p>
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="activity" value="Light" id="exerciseSometimes" required>
                <label class="form-check-label" for="exerciseSometimes">
                  <h6>ออกกำลังกายนิดๆ</h6>
                  <p class="text-green">ออกกำลังกายนิดๆ 1-3 วันต่อสัปดาห์</p>
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="activity" value="Moderate" id="exerciseOften" required>
                <label class="form-check-label" for="exerciseOften">
                  <h6>ออกกำลังกายปานกลาง</h6>
                  <p class="text-green">ออกกำลังกายปานกลาง 3-5 วันต่อสัปดาห์</p>
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="activity" value="Active" id="exerciseUsually" required>
                <label class="form-check-label" for="exerciseUsually">
                  <h6>ออกกำลังกายหนัก</h6>
                  <p class="text-green">ออกกำลังกายหนัก 6-7 วันต่อสัปดาห์</p>
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="activity" value="VeryActive" id="exerciseAlways" required>
                <label class="form-check-label" for="exerciseAlways">
                  <h6>ออกกำลังกายหนักมาก</h6>
                  <p class="text-green">ฝึกซ้อมหนักทุกวันไม่มีหยุด</p>
                </label>
              </div> 
            </div>
            <p id="error-radio" class="fw-bolder mt-2" style="color: #e74c3c;"></p>
          </div>
        </div>
        <input type="hidden" name="target" value="MaintainWeight">
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal" onclick="resetData();" id="btnCancel">ยกเลิก</button>
          <button type="submit" class="btn btn-outline-green" id="goSettarget">ตั้งเป้าหมาย</button>
        </div>
      </form> <!-- end of form -->
    </div>
  </div>
</div> <!-- End of BalanceWeight -->

