                                <form class="d-flex" style="justify-content: end;">
                                    <button type="button" class="btn btn-outline-green" data-bs-toggle="modal" data-bs-target="#loseweight">
                                        เลือกเป้าหมาย
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card border-secondary mb-3 col-lg g-start-2" style="max-width: 540px;">
