<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content=""/>
    <meta name="author" content=""/>
    <title>Current Target</title>
    <!-- add icon link -->
    <link rel="icon" href="image/Logo_CalorieCare.png" type="image/x-icon" />
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico"/>
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet"/>
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="css/styles.css" rel="stylesheet"/>
    <link rel="stylesheet" href="https://site-assets.fontawesome.com/releases/v6.6.0/css/all.css"/>
    <style>
      li {
          display: block;
          list-style-type: disc;
          margin-top: 0;
          margin-bottom: 0;
          margin-left: 0;
          margin-right: 0;
          padding-left: 100px;
          }
          @media (max-width: 767.98px) {
            li {
                display: block;
                list-style-type: disc;
                text-align: end;
                margin-top: 0;
                margin-bottom: 0;
                margin-left: 0;
                margin-right: 0;
                padding-left: 0;
            } 
            .grid {
                grid-template-columns: 1fr; /* ให้เป็น 1 คอลัมน์สำหรับขนาดเล็ก */
            }
            h1 {
                text-align: end; /* จัดข้อความใน h1 ไปทางขวา */
                font-size: 40px;
            }
            }
  </style>
</head>
<body>
        <!-- Navigation-->
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container px-4 px-lg-5">
                <a class="navbar-brand" href="/home">
                    <img src="image/logo.png" alt="Bootstrap" width="48" height="48">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 d-flex justify-content-between">
                        <li class="nav-item"><a class="nav-link" href="/home">หน้าหลัก</a></li>
                        <li class="nav-item"><a class="nav-link" href="/excercise">ออกกำลังกาย</a></li>
                        <li class="nav-item"><a class="nav-link" href="/history">ประวัติ</a></li>
                        <li class="nav-item"><a class="nav-link active" aria-current="page" href="/target">เป้าหมาย</a></li>
                        <li class="nav-item"><a class="nav-link" href="/calculator">คำนวณ</a></li>
                    </ul>
        
                    <form>
                        <% if (loggedIn) { %>
                            <h1 class="m-0"><a class="nav-link" href="/profile"><i class="bi bi-person-circle text-green"></i></a></h1>
                        <% } %>
        
                        <% if (!loggedIn) { %>
                            <a class="btn btn-outline-green mx-3" href="/login">เข้าสู่ระบบ</a>
                            <a class="btn btn-outline-green" href="/register">สมัครสมาชิก</a>
                        <% } %>
                    </form>
                </div>
            </div>
        </nav>

    <div class="container px-4 px-lg-5 my-5r">
        <div class="text-start text-black">
            <h2 class="display-8 fw-bolder pb-4">เป้าหมายปัจจุบันของคุณ</h2>
        </div>
        <div class="card border-secondary mb-3 col-lg g-start-2" style="max-width: 540px;">
          <div class="card-body">
              <h5 class="text-center">น้ำหนักปัจจุบันของคุณ : <%= UserData.weight %> (kg.)</h5>
          </div>
        </div>
        <div class="grid text-center" style="--bs-rows: 3; --bs-columns: 3;">

          <% if (UserData.target === "GainWeight") { %>
            <div class="card border-secondary mb-3 col-lg g-start-2" style="max-width: 540px;">
                <div class="row g-0"> 
                    <div class="col-lg-7 col-7">
                        <div class="card-body">
                            <h3 class="card-title text-start fw-bolder pt-3">เพิ่มน้ำหนัก</h3>
                            <p class="card-text text-start text-green">
                                <% if (UserData.weight_gain_rate === 0.25) { %>
                                    เพิ่มน้ำหนัก 0.25 กิโลกรัมต่อสัปดาห์
                                <% } else if (UserData.weight_gain_rate === 0.5) { %>
                                    เพิ่มน้ำหนัก 0.5 กิโลกรัมต่อสัปดาห์
                                <% } else if (UserData.weight_gain_rate === 0.75) { %>
                                    เพิ่มน้ำหนัก 0.75 กิโลกรัมต่อสัปดาห์
                                <% } else if (UserData.weight_gain_rate === 1) { %>
                                    เพิ่มน้ำหนัก 1 กิโลกรัมต่อสัปดาห์
                                <% } else { %>
                                    ไม่ระบุอัตราการเพิ่มน้ำหนัก
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-5 col-5">
                        <img src="image/gym.png" class="img-fluid rounded-start ms-3" style="position: relative; top: 10%; right: 0; width: 70px; height: 70px;">
                        <br><br><br>
                        <form action="/user/edittarget" method="POST" class="mb-3">
                          <button type="submit" class="btn btn-outline-green" style="position: relative; left: 0; bottom: 10%; width: 70%;"><i class="fa-light fa-pen-to-square"></i> แก้ไข</i></button>
                        </form>
                    </div>
                </div>
            </div>
        
            <div class="card border-secondary mb-3 col-lg g-start-2" style="max-width: 540px;">
                <div class="row g-0">
                    <div class="col-lg-8 col-8">
                        <div class="card-body">
                            <h3 class="card-title text-start fw-bolder pt-3">กิจกรรม</h3>
                            <p class="card-text text-start text-green">
                              <% if (UserData.activity === 'Sedentary') { %>
                                ออกกำลังกายน้อย
                            <% } else if (UserData.activity === 'Light') { %>
                                ออกกำลังกายเบาๆ 1-3 วันต่อสัปดาห์
                            <% } else if (UserData.activity === 'Moderate') { %>
                                ออกกำลังกายปานกลาง 3-5 วันต่อสัปดาห์
                            <% } else if (UserData.activity === 'Active') { %>
                                ออกกำลังกายหนักมาก 6-7 วันต่อสัปดาห์
                            <% } else if (UserData.activity === 'VeryActive') { %>
                                ฝึกซ้อมหนักทุกวันไม่หยุด
                            <% } else { %>
                                ไม่ระบุประเภทกิจกรรม
                            <% } %>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-4">
                        <br><br>
                        <img src="image/stretching.png" class="img-fluid rounded-start ms-3" style="position: relative; bottom: 20%; right: 10%; width: 100px; height: 100px;">
                    </div>
                </div>
            </div>
        <% } %>
        
        <% if (UserData.target === "LoseWeight") { %>
            <div class="card border-secondary mb-3 col-lg g-start-2" style="max-width: 540px;">
                <div class="row g-0"> 
                    <div class="col-lg-7 col-7">
                        <div class="card-body">
                            <h3 class="card-title text-start fw-bolder pt-3">ลดน้ำหนัก</h3>
                            <p class="card-text text-start text-green">
                                <% if (UserData.weight_loss_rate === 0.25) { %>
                                    ลดน้ำหนัก 0.25 กิโลกรัมต่อสัปดาห์
                                <% } else if (UserData.weight_loss_rate === 0.5) { %>
                                    ลดน้ำหนัก 0.5 กิโลกรัมต่อสัปดาห์
                                <% } else if (UserData.weight_loss_rate === 0.75) { %>
                                    ลดน้ำหนัก 0.75 กิโลกรัมต่อสัปดาห์
                                <% } else if (UserData.weight_loss_rate === 1) { %>
                                    ลดน้ำหนัก 1 กิโลกรัมต่อสัปดาห์
                                <% } else { %>
                                    ไม่ระบุอัตราการลดน้ำหนัก
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-5 col-5">
                        <img src="image/stockdown.png" class="img-fluid rounded-start ms-3" style="position: relative; top: 10%; right: 0; width: 70px; height: 70px;">
                        <br><br><br>
                        <form action="/user/edittarget" method="POST" class="mb-3">
                          <button type="submit" class="btn btn-outline-green" style="position: relative; left: 0; bottom: 10%; width: 70%;"><i class="fa-light fa-pen-to-square"></i> แก้ไข</i></button>
                        </form>
                    </div>
                </div>
            </div>
        
            <div class="card border-secondary mb-3 col-lg g-start-2" style="max-width: 540px;">
                <div class="row g-0">
                    <div class="col-lg-8 col-8">
                        <div class="card-body">
                            <h3 class="card-title text-start fw-bolder pt-3">กิจกรรม</h3>
                            <p class="card-text text-start text-green">
                                <% if (UserData.activity === 'Sedentary') { %>
                                    ออกกำลังกายน้อย
                                <% } else if (UserData.activity === 'Light') { %>
                                    ออกกำลังกายเบาๆ 1-3 วันต่อสัปดาห์
                                <% } else if (UserData.activity === 'Moderate') { %>
                                    ออกกำลังกายปานกลาง 3-5 วันต่อสัปดาห์
                                <% } else if (UserData.activity === 'Active') { %>
                                    ออกกำลังกายหนักมาก 6-7 วันต่อสัปดาห์
                                <% } else if (UserData.activity === 'VeryActive') { %>
                                    ฝึกซ้อมหนักทุกวันไม่หยุด
                                <% } else { %>
                                    ไม่ระบุประเภทกิจกรรม
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-4">
                        <br><br>
                        <img src="image/stretching.png" class="img-fluid rounded-start ms-3" style="position: relative; bottom: 20%; right: 10%; width: 100px; height: 100px;">
                    </div>
                </div>
            </div>
        <% } %>

            <div class="card border-secondary mb-3 col-lg g-start-2" style="max-width: 540px;">
                <div class="card-body">
                    <h5 class="text-center">น้ำหนักเป้าหมายของคุณ : <%= UserData.weight_target %> (kg.)</h5>
                </div>
            </div>

        </div>
    </div>

    
        <!-- set target Modal-->
        <div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="text-center">
                  <img src="image/Logo 1.png" alt="Bootstrap" width="250" height="250">
                  <p class="m-0">
                    <h4 class="text-green">ตั้งเป้าหมายสำเร็จ</h4>
                    <h6>คุณทำตั้งเป้าหมายสำเร็จ</h6>
                    <img class="mt-3" src="image/checked.png" alt="Bootstrap" width="100" height="100"><br>
                    <button class="btn btn-outline-green mt-3"><a href="/currentTarget" class="link-green" style="text-decoration: none;">กลับเข้าสู่หน้าเป้าหมาย</a></button>
                  </p>
                </div>
              </div>
            </div>
          </div> <!-- End of set target Modal -->

    <!-- Footer-->
      <footer class="py-5 bg-green" style="position: absolute; left: 0; bottom: 0; width: 100%;">
        <div class="container"><p class="m-0 text-center text-white">Copyright &copy; CalorieCare 2024</p></div>
      </footer>

      <!-- Core theme JS-->
      <script src="js/currentTarget.js"></script>
</body>
</html>